# ============================================
# WorkMate Environment Variables
# Copy this file to server/.env and fill values
# ============================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
# For local MongoDB: mongodb://localhost:27017/workmate

# JWT
JWT_SECRET=replace_with_long_random_string
JWT_EXPIRE=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Razorpay Test Mode (optional — app works without these using demo simulation)
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=replace_with_test_secret

# Cloudinary (optional — app works without these using placeholder URLs)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret
